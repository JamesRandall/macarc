{
  "scopeName": "source.bbcbasic",
  "name": "BBC BASIC V",
  "patterns": [
    {
      "name": "constant.numeric.line-number.bbcbasic",
      "match": "^\\s*[0-9]+"
    },
    {
      "begin": "\\b(REM)",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.rem.bbcbasic"
        }
      },
      "name": "comment.line.rem.bbcbasic"
    },
    {
      "name": "string.quoted.double.bbcbasic",
      "begin": "\"",
      "end": "\"|$"
    },
    {
      "begin": "\\b(DATA)",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.data.bbcbasic"
        }
      },
      "name": "string.unquoted.data.bbcbasic"
    },
    {
      "name": "meta.assembler.bbcbasic",
      "begin": "\\[",
      "end": "\\]",
      "patterns": [
        {
          "name": "comment.line.assembler.bbcbasic",
          "match": "[\\\\;].*?(?=:|\\]|$)"
        },
        {
          "name": "keyword.mnemonic.bbcbasic",
          "match": "(?i)\\b(adc|add|and|b|bic|bl|cmn|cmp|eor|ldm|ldr|mla|mov|mul|mvn|orr|rsb|rsc|sbc|stm|str|sub|swi|swp|teq|tst|adr|mrc|mcr|ldc|stc|cdp|opt|equb|equw|equd|equs|equf|align|dcb|dcw|dcd|dcs)(eq|ne|cs|hs|cc|lo|mi|pl|vs|vc|hi|ls|ge|lt|gt|le|al|nv)?(s|b|t|bt|ia|ib|da|db|fd|ed|fa|ea|p)?\\b"
        },
        {
          "name": "variable.language.register.bbcbasic",
          "match": "(?i)\\b(r[0-9]|r1[0-5]|pc|sp|lr)\\b"
        },
        {
          "name": "entity.name.function.label.bbcbasic",
          "match": "\\.[A-Za-z_][A-Za-z0-9_]*[%$]?"
        },
        {
          "name": "constant.numeric.hex.bbcbasic",
          "match": "&[0-9A-Fa-f]+"
        }
      ]
    },
    {
      "name": "entity.name.function.bbcbasic",
      "match": "\\b(PROC|FN)[A-Za-z0-9_@`]+"
    },
    {
      "name": "keyword.control.bbcbasic",
      "match": "\\b(IF|THEN|ELSE|ENDIF|FOR|TO|STEP|NEXT|REPEAT|UNTIL|WHILE|ENDWHILE|CASE|OF|WHEN|OTHERWISE|ENDCASE|GOTO|GOSUB|RETURN|ON|ERROR|DEF|ENDPROC|END|STOP|LOCAL|RUN|CHAIN|QUIT|LIBRARY|INSTALL|OVERLAY)"
    },
    {
      "name": "keyword.operator.word.bbcbasic",
      "match": "\\b(AND|OR|EOR|NOT|DIV|MOD)"
    },
    {
      "name": "support.function.bbcbasic",
      "match": "\\b(ABS|ACS|ADVAL|ASC|ASN|ATN|BGET|CHR\\$|COS|COUNT|DEG|EOF|ERL|ERR|EVAL|EXP|EXT|GET\\$|GET|INKEY\\$|INKEY|INSTR\\(|INT|LEFT\\$\\(|LEN|LN|LOG|MID\\$\\(|OPENIN|OPENOUT|OPENUP|PI|POINT\\(|POS|RAD|RIGHT\\$\\(|RND|SGN|SIN|SQR|STR\\$|STRING\\$\\(|TAN|USR|VAL|VPOS|TRUE|FALSE|PAGE|TOP|LOMEM|HIMEM|TIME|PTR|SUM|BEAT|REPORT\\$)"
    },
    {
      "name": "keyword.other.bbcbasic",
      "match": "\\b(APPEND|AUTO|BEATS|BPUT|CALL|CIRCLE|CLEAR|CLOSE|CLG|CLS|COLOUR|CRUNCH|DELETE|DIM|DRAW|EDIT|ELLIPSE|ENVELOPE|FILL|GCOL|HELP|INPUT|LET|LINE|LIST|LOAD|LVAR|MODE|MOUSE|MOVE|NEW|OFF|OLD|ORIGIN|OSCLI|PLOT|POINT|PRINT|READ|RECTANGLE|RENUMBER|REPORT|RESTORE|SAVE|SOUND|SPC|STEREO|SWAP|SYS|TAB\\(|TEMPO|TEXTLOAD|TEXTSAVE|TINT|TRACE|TWINO|TWIN|VDU|VOICES|VOICE|WAIT|WIDTH)"
    },
    {
      "name": "keyword.other.star-command.bbcbasic",
      "match": "^\\s*[0-9]*\\s*\\*.*$"
    },
    {
      "name": "constant.numeric.hex.bbcbasic",
      "match": "&[0-9A-Fa-f]+"
    },
    {
      "name": "constant.numeric.decimal.bbcbasic",
      "match": "\\b[0-9]+(\\.[0-9]*)?(E[-+]?[0-9]+)?\\b"
    },
    {
      "name": "variable.other.bbcbasic",
      "match": "[A-Za-z_@`][A-Za-z0-9_`]*[%$]?"
    }
  ]
}
